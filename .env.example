# Copy to .env (git ignores it). These keys stay on the server: the page never sees them, and the
# relay lends them only to visitors who bring no key of their own.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Optional
# PORT=3141
# DATA_DIR=./data
# TypeSafe input tokens lent per UTC day. 20000000 is about $0.84 a day, roughly 100 games. 0 lends none.
# DAILY_TOKEN_BUDGET=20000000
# OpenRouter requests lent per UTC day, free models only. A game takes 40 to 100.
# DAILY_LLM_BUDGET=3000
# The share of a day's lending one visitor may take.
# VISITOR_SHARE=0.25
