# Copy to .env (git ignores it). These keys stay on the server: the page never sees them, and the
# relay lends them only to visitors who bring no key of their own.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Optional
# PORT=3141
# DATA_DIR=./data
# TypeSafe input tokens lent per UTC day. 20000000 is about $0.84 a day, roughly 100 games. 0 lends none.
# DAILY_TOKEN_BUDGET=20000000
# OpenRouter requests lent per UTC day. A game takes 40 to 100.
# DAILY_LLM_BUDGET=3000
# Dollars of OpenRouter credit lent per UTC day.
# DAILY_LLM_SPEND=0.5
# The dearest model lent, in dollars per million tokens. Dearer ones need the visitor's own key.
# A game is about 250k tokens, so 0.5 keeps one game inside a visitor's share of the day.
# MAX_MODEL_PRICE=0.5
# The share of a day's lending one visitor may take.
# VISITOR_SHARE=0.25
